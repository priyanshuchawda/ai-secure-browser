{
  "name": "ai-secure-browser",
  "version": "1.0.0",
  "description": "AI-driven cybersecurity browser with proactive threat protection",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "check-setup": "node -e \"console.log('Setup OK: Node', process.version)\""
